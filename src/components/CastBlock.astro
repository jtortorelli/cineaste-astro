---
import RoleRow, { type RolePerson } from "./RoleRow.astro";
import { processRoleName, type CastEntry } from "../lib/films";

interface Props {
  heading?: string;
  block: CastEntry[];
}

const { heading, block } = Astro.props;

function personLine(entry: CastEntry): RolePerson {
  return {
    name: entry.name,
    slug: entry.slug,
    alias: entry.alias,
    qualifiers: entry.qualifiers,
    uncredited: entry.uncredited,
    disambig_chars: entry.disambig_chars,
  };
}
---

<section class="cast-group">
  {heading && <h3 class="cast-subhead">{heading}</h3>}
  <div class="cast-grid">
    {
      block.map((cast) => (
        <RoleRow
          avatar_url={cast.avatar_url}
          avatar_alt={cast.name}
          role={processRoleName(cast.role)}
          roleHtml={true}
          character_qualifiers={cast.character_qualifiers}
          people={[personLine(cast), ...(cast.secondary ?? []).map(personLine)]}
        />
      ))
    }
  </div>
</section>
