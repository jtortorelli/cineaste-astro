---
import MaybeLinkUrl from "./MaybeLinkUrl.astro";

interface Props {
  name: string;
  subtitle?: string;
  alias?: string;
  domain?: string;
  history?: string;
  isbn?: string;
  author?: string;
  works?: string;
  image_url?: string;
  resource_url?: string;
}

const {
  name,
  subtitle,
  alias,
  domain,
  history,
  isbn,
  author,
  works,
  image_url,
  resource_url,
} = Astro.props;
---

<div class="p-5">
  {
    image_url && (
      <div class="lg:h-[150px] flex lg:items-center justify-center">
        <div>
          <MaybeLinkUrl resource_url={resource_url}>
            <img class="max-w-[150px] max-h-[150px]" src={image_url} />
          </MaybeLinkUrl>
        </div>
      </div>
    )
  }

  <div class="text-center">
    <div class="font-content text-gray-700">
      <MaybeLinkUrl resource_url={resource_url}>{name}</MaybeLinkUrl>
    </div>

    {subtitle && <div class="font-content text-gray-700 text-sm">{subtitle}</div>}

    {alias && <div class="font-content text-sm text-gray-500">aka {alias}</div>}

    {
      domain && (
        <div class="font-detail text-red-500 text-xs">
          <MaybeLinkUrl resource_url={resource_url}>{domain}</MaybeLinkUrl>
        </div>
      )
    }

    {history && <div class="font-content text-sm text-gray-700">{history}</div>}

    {isbn && <div class="font-detail text-red-500 text-xs">ISBN: {isbn}</div>}

    {author && <div class="font-content text-sm text-gray-700">{author}</div>}

    {works && <div class="font-content text-sm text-gray-500" set:html={works} />}
  </div>
</div>
