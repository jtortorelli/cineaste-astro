---
import PersonShowcaseLink from "./PersonShowcaseLink.astro";

export interface RolePerson {
  name?: string;
  slug?: string;
  alias?: string;
  qualifiers?: string;
  uncredited?: boolean;
  disambig_chars?: string;
}

interface Props {
  avatar_url?: string;
  avatar_alt: string;
  role: string;
  roleHtml?: boolean;
  character_qualifiers?: string;
  people: RolePerson[];
}

const {
  avatar_url,
  avatar_alt,
  role,
  roleHtml = false,
  character_qualifiers,
  people,
} = Astro.props;

---

<article class="role-row">
  {
    avatar_url ? (
      <img class="role-still" src={avatar_url} alt={avatar_alt} width="52" height="52" />
    ) : (
      <div class="role-still role-still-empty" aria-hidden="true" />
    )
  }
  <div class="role-body">
    <div class="role-label">
      {roleHtml ? <span set:html={role} /> : role}
    </div>
    {
      character_qualifiers && (
        <div class="role-note">{character_qualifiers}</div>
      )
    }
    {
      people.map((person) => (
        <div class="role-person">
          {person.name ? (
            <span>
              <PersonShowcaseLink slug={person.slug}>
                {person.name}
                {person.disambig_chars && (
                  <span class="role-disambig">
                    (<span lang="ja" class="font-japanese">{person.disambig_chars}</span>)
                  </span>
                )}
              </PersonShowcaseLink>
              {person.qualifiers && (
                <span class="role-qualifier"> · {person.qualifiers}</span>
              )}
              {person.uncredited && (
                <span class="role-uncredited"> · uncredited</span>
              )}
            </span>
          ) : (
            <>
              {person.qualifiers && (
                <span class="role-qualifier">{person.qualifiers}</span>
              )}
              {person.uncredited && (
                <span class="role-uncredited">uncredited</span>
              )}
            </>
          )}
          {person.alias && (
            <div class="role-alias">as {person.alias}</div>
          )}
        </div>
      ))
    }
  </div>
</article>

<style>
  .role-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .role-still {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--color-gray-100);
  }
  .role-still-empty {
    display: block;
  }
  .role-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .role-label {
    font-family: var(--font-detail);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .role-person {
    font-family: var(--font-content);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-gray-700);
  }
  .role-disambig {
    font-size: 0.75rem;
  }
  .role-note,
  .role-alias {
    font-family: var(--font-content);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-gray-500);
  }
  .role-alias {
    margin-top: 1px;
  }
  .role-qualifier,
  .role-uncredited {
    font-family: var(--font-detail);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .role-qualifier {
    color: var(--color-gray-500);
  }
  .role-uncredited {
    color: var(--color-red-700);
  }
</style>
