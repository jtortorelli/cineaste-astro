---
import SocialLink from "./SocialLink.astro";

interface VideoReview {
  youtube_url?: string;
  rumble_url?: string;
  odysee_url?: string;
}

interface Props {
  video_review?: VideoReview;
}

const { video_review } = Astro.props;
---

{
  video_review?.youtube_url ||
  video_review?.rumble_url ||
  video_review?.odysee_url ? (
    <div class="text-center w-fit m-auto pt-2 pb-4">
      <div class="font-content text-sm text-gray-700 pb-1">
        Watch the video review
      </div>
      <nav class="flex flex-wrap justify-center items-center gap-1" aria-label="Video review">
        {video_review.youtube_url && (
          <SocialLink href={video_review.youtube_url} name="youtube" label="YouTube" />
        )}
        {video_review.rumble_url && (
          <SocialLink href={video_review.rumble_url} name="rumble" label="Rumble" />
        )}
        {video_review.odysee_url && (
          <SocialLink href={video_review.odysee_url} name="odysee" label="Odysee" />
        )}
      </nav>
    </div>
  ) : null
}
