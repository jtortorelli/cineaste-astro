---
import CastBlock from "./CastBlock.astro";
import CastCatalog from "./CastCatalog.astro";
import NamedDivider from "./NamedDivider.astro";
import { castFromCsv } from "../lib/films";

interface Props {
  rows: Record<string, string>[];
}

const { rows } = Astro.props;
const { topBilled, supporting } = castFromCsv(rows);
const showSubheads = topBilled.length > 0 && supporting.length > 0;
---

{
  (topBilled.length > 0 || supporting.length > 0) && (
    <>
      <NamedDivider name="Cast" />
      <CastCatalog>
        {topBilled.length > 0 && (
          <CastBlock
            heading={showSubheads ? "Top billed" : undefined}
            block={topBilled}
          />
        )}
        {supporting.length > 0 && (
          <CastBlock heading="Supporting" block={supporting} />
        )}
      </CastCatalog>
    </>
  )
}
