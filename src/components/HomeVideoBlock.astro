---
import FilmShowcaseLink from "./FilmShowcaseLink.astro";
import Icon from "./Icon.astro";
import NamedDivider from "./NamedDivider.astro";
import { homeVideoArtUrl, type HomeVideoRelease } from "../lib/films";

interface Props {
  filmSlug: string;
  releases: HomeVideoRelease[];
}

const { filmSlug, releases } = Astro.props;

function canonicalFormat(format: string): string {
  const key = format.toLowerCase().replace(/[_\s]+/g, "-");
  if (key === "blu-ray" || key === "bd") return "bluray";
  if (key === "uhd" || key === "4k-uhd" || key === "ultra-hd") return "4k";
  return key;
}

function formatMark(format: string): { name: string; label: string } {
  const key = canonicalFormat(format);
  if (key === "vhs") return { name: "device-audio-tape", label: "VHS" };
  if (key === "dvd") return { name: "disc", label: "DVD" };
  if (key === "bluray") return { name: "bluray", label: "Blu-ray" };
  if (key === "4k") return { name: "badge-4k", label: "4K" };
  if (key === "vod") return { name: "device-tv", label: "VOD" };
  return { name: "movie", label: format };
}

const FORMAT_RANK: Record<string, number> = {
  vhs: 0,
  dvd: 1,
  bluray: 2,
  "4k": 3,
  vod: 4,
};

const groups = [...releases.reduce((map, release) => {
  const key = canonicalFormat(release.format);
  const list = map.get(key) ?? [];
  list.push(release);
  map.set(key, list);
  return map;
}, new Map<string, HomeVideoRelease[]>())].sort(([a], [b]) => {
  const rank = (FORMAT_RANK[a] ?? 99) - (FORMAT_RANK[b] ?? 99);
  return rank !== 0 ? rank : a.localeCompare(b);
}).map(([key, list]) => ({
  ...formatMark(key),
  releases: [...list].sort((a, b) => {
    const year = Number(a.year) - Number(b.year);
    return year !== 0 ? year : a.title.localeCompare(b.title);
  }),
}));
---

{
  releases.length > 0 && (
    <>
      <NamedDivider name="Home Video" />
      <div class="home-video font-content text-sm text-gray-700">
        {groups.map((group) => (
          <section class="home-video-group">
            <div class="format-heading">
              <Icon
                name={group.name}
                set="tabler"
                variant="outline"
                class="h-4 w-4"
              />
              <span>{group.label}</span>
            </div>
            {group.releases.map((release) => {
          const companions = release.films.filter(
            (film) => film.slug !== filmSlug,
          );
          const artUrl = homeVideoArtUrl(release.slug);
          return (
            <div class="flex gap-4 items-start">
              {artUrl && (
                <img
                  class="rounded-lg drop-shadow-lg w-[120px] h-auto object-contain shrink-0 self-start"
                  src={artUrl}
                  alt={release.title}
                />
              )}
              <div>
                <div class="italic">{release.title}</div>
                <div class="text-xs text-gray-500">
                  {release.publisher}, {release.year}
                </div>
                {companions.length > 0 && (
                  <div class="pt-2">
                    <div class="uppercase font-detail text-xs text-gray-500">
                      also includes
                    </div>
                    {companions.map((film) => (
                      <div>
                        {film.showcased ? (
                          <FilmShowcaseLink slug={film.slug}>
                            <span class="italic">{film.title}</span>
                            {film.year && <> ({film.year})</>}
                          </FilmShowcaseLink>
                        ) : (
                          <>
                            <span class="italic">{film.title}</span>
                            {film.year && <> ({film.year})</>}
                          </>
                        )}
                      </div>
                    ))}
                  </div>
                )}
                {release.notes && (
                  <div class="text-xs text-gray-500 pt-2">
                    {release.notes
                      .split(";")
                      .map((note) => note.trim())
                      .filter(Boolean)
                      .map((note) => (
                        <div>{note}</div>
                      ))}
                  </div>
                )}
              </div>
            </div>
          );
            })}
          </section>
        ))}
      </div>
    </>
  )
}

<style>
  .home-video {
    width: min(100%, 40rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .home-video-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .format-heading {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-detail);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-700);
  }
</style>
