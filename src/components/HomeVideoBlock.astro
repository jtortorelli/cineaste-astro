---
import FilmShowcaseLink from "./FilmShowcaseLink.astro";
import Icon from "./Icon.astro";
import NamedDivider from "./NamedDivider.astro";
import { homeVideoArtUrl, type HomeVideoRelease } from "../lib/films";

interface Props {
  filmSlug: string;
  releases: HomeVideoRelease[];
}

const { filmSlug, releases } = Astro.props;

const INLINE_LIMIT = 2;

function canonicalFormat(format: string): string {
  const key = format.toLowerCase().replace(/[_\s]+/g, "-");
  if (key === "blu-ray" || key === "bd") return "bluray";
  if (key === "uhd" || key === "4k-uhd" || key === "ultra-hd") return "4k";
  return key;
}

function formatMark(format: string): { name: string; label: string } {
  const key = canonicalFormat(format);
  if (key === "vhs") return { name: "device-audio-tape", label: "VHS" };
  if (key === "dvd") return { name: "disc", label: "DVD" };
  if (key === "bluray") return { name: "bluray", label: "Blu-ray" };
  if (key === "4k") return { name: "badge-4k", label: "4K" };
  if (key === "vod") return { name: "device-tv", label: "VOD" };
  return { name: "movie", label: format };
}

const FORMAT_RANK: Record<string, number> = {
  vhs: 0,
  dvd: 1,
  bluray: 2,
  "4k": 3,
  vod: 4,
};

const groups = [...releases.reduce((map, release) => {
  const key = canonicalFormat(release.format);
  const list = map.get(key) ?? [];
  list.push(release);
  map.set(key, list);
  return map;
}, new Map<string, HomeVideoRelease[]>())].sort(([a], [b]) => {
  const rank = (FORMAT_RANK[a] ?? 99) - (FORMAT_RANK[b] ?? 99);
  return rank !== 0 ? rank : a.localeCompare(b);
}).map(([key, list]) => ({
  ...formatMark(key),
  setLabel: key === "vod" ? "Collection" : "Box set",
  releases: [...list].sort((a, b) => {
    const year = Number(a.year) - Number(b.year);
    return year !== 0 ? year : a.title.localeCompare(b.title);
  }).map((release) => ({
    ...release,
    artUrl: homeVideoArtUrl(release.slug),
    notes: (release.notes ?? "").split(";").map((n) => n.trim()).filter(Boolean),
    companions: release.films.filter((film) => film.slug !== filmSlug),
  })),
}));
---

{
  releases.length > 0 && (
    <>
      <NamedDivider name="Home Video" />
      <div class="home-video">
        {groups.map((group) => (
          <section class="hv-group">
            <h3 class="hv-format">
              <Icon name={group.name} set="tabler" variant="outline" class="hv-format-icon" />
              <span>{group.label}</span>
            </h3>
            <div class="hv-grid">
              {group.releases.map((release) => (
                <article class="hv-card">
                  {release.artUrl ? (
                    <div class="hv-cover">
                      <img src={release.artUrl} alt="" loading="lazy" width="64" height="90" />
                    </div>
                  ) : (
                    <div class="hv-cover hv-cover-empty" aria-hidden="true">
                      <Icon name={group.name} set="tabler" variant="outline" class="h-6 w-6" />
                    </div>
                  )}
                  <div class="hv-body">
                    <div class="hv-title">{release.title}</div>
                    <div class="hv-meta">{release.publisher} · {release.year}</div>
                    {release.companions.length > 0 &&
                      (release.companions.length <= INLINE_LIMIT ? (
                        <div class="hv-with">
                          With{" "}
                          {release.companions.map((film, index) => (
                            <>
                              {index > 0 && ", "}
                              <FilmShowcaseLink slug={film.showcased ? film.slug : undefined}>
                                <i>{film.title}</i>
                                {film.year && <> ({film.year})</>}
                              </FilmShowcaseLink>
                            </>
                          ))}
                        </div>
                      ) : (
                        <details class="hv-more">
                          <summary>
                            {group.setLabel} · {release.films.length} films
                            <Icon name="chevron-down" set="tabler" variant="outline" class="hv-chevron" />
                          </summary>
                          <ul class="hv-films">
                            {release.companions.map((film) => (
                              <li>
                                <FilmShowcaseLink slug={film.showcased ? film.slug : undefined}>
                                  <i>{film.title}</i>
                                  {film.year && <> ({film.year})</>}
                                </FilmShowcaseLink>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ))}
                    {release.notes.length > 0 &&
                      (release.notes.length <= INLINE_LIMIT ? (
                        <ul class="hv-notes">
                          {release.notes.map((note) => <li>{note}</li>)}
                        </ul>
                      ) : (
                        <details class="hv-more">
                          <summary>
                            {release.notes.length} special features
                            <Icon name="chevron-down" set="tabler" variant="outline" class="hv-chevron" />
                          </summary>
                          <ul class="hv-notes">
                            {release.notes.map((note) => <li>{note}</li>)}
                          </ul>
                        </details>
                      ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </>
  )
}

<style>
  .home-video {
    width: min(100%, 48rem);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-family: var(--font-content);
    font-size: 0.875rem;
    color: var(--color-gray-700);
  }
  .hv-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hv-format {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--font-detail);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gray-700);
  }
  .hv-format::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--color-gray-200);
  }
  .hv-format :global(.hv-format-icon) {
    width: 18px;
    height: 18px;
    color: var(--color-red-700);
  }
  .hv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 24px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .hv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .hv-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .hv-cover {
    display: block;
    width: 64px;
    height: 90px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-gray-100);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .hv-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .hv-more summary:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 2px;
  }
  .hv-cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray-400);
    box-shadow: none;
  }
  .hv-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .hv-title {
    font-style: italic;
    line-height: 1.35;
  }
  .hv-meta {
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }
  .hv-with,
  .hv-notes {
    margin-top: 4px;
    font-size: 0.75rem;
    line-height: 1.45;
  }
  .hv-notes {
    padding: 0;
    list-style: none;
    color: var(--color-gray-500);
  }
  .hv-more {
    margin-top: 4px;
  }
  .hv-more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    list-style: none;
    font-family: var(--font-detail);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    cursor: pointer;
  }
  .hv-more summary::-webkit-details-marker {
    display: none;
  }
  .hv-more :global(.hv-chevron) {
    width: 14px;
    height: 14px;
    transition: transform 0.15s ease;
  }
  .hv-more[open] :global(.hv-chevron) {
    transform: rotate(180deg);
  }
  .hv-more summary:hover {
    color: var(--color-gray-700);
  }
  .hv-films {
    margin-top: 4px;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    line-height: 1.5;
  }
</style>
