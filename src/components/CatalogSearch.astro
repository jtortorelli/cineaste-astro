---
import Icon from "./Icon.astro";

interface Props {
  label: string;
  total: number;
  noun: string;
  empty?: boolean;
}

const { label, total, noun, empty = true } = Astro.props;
---

<div class="catalog-search">
  <label class="search-label" for="default-search">{label}</label>
  <div class="catalog-search-field">
    <span class="catalog-search-icon" aria-hidden="true">
      <Icon name="search" set="tabler" variant="outline" class="h-5 w-5" />
    </span>
    <input
      id="default-search"
      type="search"
      placeholder={label}
      autocomplete="off"
    />
    <button id="search-clear" type="button" hidden aria-label="Clear search">
      <span aria-hidden="true">
        <Icon name="x" set="tabler" variant="outline" class="h-5 w-5" />
      </span>
    </button>
  </div>
  <p
    id="search-status"
    class="search-status"
    data-total={total}
    data-noun={noun}
    aria-live="polite"
  >
    {total} {noun}
  </p>
</div>
{
  empty && (
    <p id="search-empty" class="search-empty" hidden aria-live="polite"></p>
  )
}

<style>
  .catalog-search {
    width: 100%;
    margin: 0 0 8px;
    text-align: left;
  }
  .search-label {
    display: block;
    margin: 0 0 8px;
    font-family: var(--font-detail);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .catalog-search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #d4d4d8;
    border-radius: 10px;
    padding: 4px 8px 4px 14px;
    color: var(--color-red-700);
    background: white;
  }
  .catalog-search-field:focus-within {
    outline: 2px solid var(--color-red-700);
    outline-offset: 2px;
  }
  .catalog-search-icon {
    display: flex;
    flex: none;
  }
  .catalog-search-field input {
    border: 0;
    width: 100%;
    min-width: 0;
    padding: 10px 0;
    font-family: var(--font-content);
    font-size: 1rem;
    color: var(--color-gray-700);
    background: transparent;
  }
  .catalog-search-field input:focus {
    outline: none;
  }
  .catalog-search-field input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
  #search-clear[hidden] {
    display: none !important;
  }
  #search-clear {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    padding: 0;
    color: var(--color-gray-500);
    cursor: pointer;
  }
  #search-clear:hover {
    color: var(--color-red-700);
  }
  #search-clear:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 2px;
  }
  .search-status {
    margin: 10px 0 0;
    font-family: var(--font-detail);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  :global(.search-empty) {
    margin: 28px auto;
    max-width: 28rem;
    text-align: center;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--color-gray-700);
  }
  :global(.match-note) {
    margin: 4px 0 0;
    font-family: var(--font-content);
    font-size: 12px;
    font-style: italic;
    line-height: 1.3;
    color: var(--color-gray-500);
  }
</style>
