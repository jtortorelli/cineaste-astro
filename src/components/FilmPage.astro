---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import Fact from "./Fact.astro";
import FactList from "./FactList.astro";
import CineasteLink from "./CineasteLink.astro";
import FilmShowcaseLink from "./FilmShowcaseLink.astro";
import PersonShowcaseLink from "./PersonShowcaseLink.astro";
import NamedDivider from "./NamedDivider.astro";
import ReviewStars from "./ReviewStars.astro";
import CastBlockFromCsv from "./CastBlockFromCsv.astro";
import CastCatalog from "./CastCatalog.astro";
import RoleRow, { type RolePerson } from "./RoleRow.astro";
import { formatDate } from "../lib/dates";
import {
  getAdjacentSeriesEntry,
  loadSeriesDataFromCsv,
  seriesEntryIsShowcased,
  staffFromCsv,
  kaijuFromCsv,
  type HomeVideoRelease,
  type KaijuPortrayal,
} from "../lib/films";
import type { FilmRow } from "../lib/csv";
import HomeVideoBlock from "./HomeVideoBlock.astro";

interface Props {
  slug: string;
  data: Record<string, unknown>;
  hasWrittenReview: boolean;
  filmRecord: FilmRow | null;
  seriesByName: Record<string, { slug: string }[]>;
  films: FilmRow[];
  staffs: Record<string, Record<string, string>[]>;
  casts: Record<string, Record<string, string>[]>;
  kaiju: Record<string, Record<string, string>[]>;
  credits: Record<string, Record<string, string>[]>;
  homeVideos: Record<string, HomeVideoRelease[]>;
}

const {
  slug,
  data,
  hasWrittenReview,
  filmRecord,
  seriesByName,
  films,
  staffs,
  casts,
  kaiju: kaijuBySlug = {},
  credits,
  homeVideos,
} = Astro.props;

const title = data.title as string;
const poster_url = data.poster_url as string | undefined;
const release_date = data.release_date as string;
const runtime = data.runtime as number | string | undefined;
const japanese_title = data.japanese_title as string | undefined;
const transliteration = data.transliteration as string | undefined;
const translation = data.translation as string | undefined;
const aliases = data.aliases as
  | { alias: string; context?: string }[]
  | undefined;
const original_works = data.original_works as
  | {
      title?: string;
      format?: string;
      authors?: { name: string; slug?: string }[];
      studios?: { name: string }[];
    }[]
  | undefined;
const studios = data.studios as string[] | undefined;
const kaiju = kaijuFromCsv(kaijuBySlug[slug] ?? []);

function kaijuRolePeople(portrayals: KaijuPortrayal[]): RolePerson[] {
  const people: RolePerson[] = [];
  const extraQualifiers: string[] = [];

  for (const portrayal of portrayals) {
    if (portrayal.people?.length) {
      for (const person of portrayal.people) {
        people.push({
          name: person.name,
          slug: person.slug,
          alias: person.alias,
          qualifiers: portrayal.type,
        });
      }
      continue;
    }

    if (!portrayal.type) continue;

    if (portrayal.type.toLowerCase() === "suit actor") {
      people.push({ qualifiers: portrayal.type });
    } else {
      extraQualifiers.push(portrayal.type);
    }
  }

  if (extraQualifiers.length > 0) {
    people.push({ qualifiers: extraQualifiers.join(", ") });
  }

  return people;
}
const video_review = data.video_review as
  | { star_rating?: number | string }
  | undefined;

const seriesData = loadSeriesDataFromCsv(
  filmRecord?.series_name,
  seriesByName,
  slug,
  films,
);
const precedingSeriesEntry = seriesData
  ? getAdjacentSeriesEntry(
      seriesData.mappedSeriesEntries,
      seriesData.filmSeriesIndex,
      -1,
    )
  : null;
const nextSeriesEntry = seriesData
  ? getAdjacentSeriesEntry(
      seriesData.mappedSeriesEntries,
      seriesData.filmSeriesIndex,
      1,
    )
  : null;
const displayStaff = staffFromCsv(staffs[slug] ?? []);
const castCsv = casts[slug] ?? [];
const creditRows = credits[slug];

type CreditLine = Record<string, string> & { continued: boolean };
const creditCards: CreditLine[][] = [];
if (creditRows) {
  let card: CreditLine[] = [];
  for (const row of creditRows) {
    if (!Object.values(row).some(Boolean)) {
      if (card.length) creditCards.push(card);
      card = [];
      continue;
    }
    card.push({ ...row, continued: !row.role && !row.japanese_role && card.length > 0 });
  }
  if (card.length) creditCards.push(card);
}

const slugsByPersonName = new Map<string, string[]>();
for (const person of await getCollection("people")) {
  const name = person.data.name as string;
  slugsByPersonName.set(name, [...(slugsByPersonName.get(name) ?? []), person.id]);
}
function personSlugFor(name: string): string | undefined {
  const matches = slugsByPersonName.get(name);
  return matches?.length === 1 ? matches[0] : undefined;
}
---

<div class="text-center w-fit m-auto">
  <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
    {title}
  </h1>
</div>
<div class="film-hero">
  <div class="film-poster">
    <img
      class="rounded-lg drop-shadow-lg"
      height={400}
      width={270}
      src={poster_url}
      alt={`Poster for ${title}`}
    />
  </div>
  <div class="film-side">
<FactList>
  {
    hasWrittenReview && (
      <Fact label="Review" class="border-b border-gray-200 pb-3">
        <ReviewStars
          align="start"
          star_rating={video_review?.star_rating}
          show_label={true}
        />
        <div class="read-link">
          <CineasteLink href={`/films/${slug}/review`}>Read</CineasteLink>
        </div>
      </Fact>
    )
  }
  <Fact label="Released">{formatDate(release_date, "d MMM yyyy")}</Fact>
  {runtime && <Fact label="Runtime">{runtime} min</Fact>}
  <Fact label="Japanese title">
    <span lang="ja" class="font-japanese tracking-wide" set:html={japanese_title} />
    <br />
    <span class="fact-note">{transliteration}</span>
    {
      transliteration !== translation && (
        <>
          <br />
          <span class="fact-note">{translation}</span>
        </>
      )
    }
  </Fact>
  {
    original_works?.map((work) => (
      <Fact label="Source">
          {work.title && (
            <>
              <span class="italic">{work.title}</span>
              <br />
            </>
          )}
          <span class="fact-note fact-plain">
            {work.format
              ? `${work.format.charAt(0).toUpperCase()}${work.format.slice(1)} by`
              : "By"}
          </span>
          {work.authors?.map((a) => (
            <>
              {" "}
              <PersonShowcaseLink slug={a.slug}>{a.name}</PersonShowcaseLink>
            </>
          ))}
          {work.studios?.map((s) => (
            <>
              {" "}
              {s.name}
            </>
          ))}
      </Fact>
    ))
  }
  {
    aliases && aliases.length > 0 && (
      <Fact label="Also known as">
        {aliases.map((a) => (
          <div>
            <span class="italic">{a.alias}</span>
            {a.context && <div class="fact-note fact-plain">{a.context}</div>}
          </div>
        ))}
      </Fact>
    )
  }
  {
    seriesData && (
      <Fact label="Series">
          <span>
            <button type="button" class="series-open series-name" onclick="series_modal.showModal(); series_modal.querySelector('[aria-current]')?.scrollIntoView({ block: 'center' })">
              {seriesData.seriesTitle} Series
            </button>
            {" "}No. {seriesData.filmSeriesIndex + 1}
          </span>
          <span>
              <dialog id="series_modal" class="modal">
                <div class="modal-box max-h-[85vh]">
                  <form method="dialog" class="modal-close">
                    <button aria-label="Close" class="btn btn-sm btn-circle btn-ghost text-gray-700">
                      <Icon name="x" set="tabler" variant="outline" class="h-5 w-5" />
                    </button>
                  </form>
                  <NamedDivider name={`${seriesData.seriesTitle} Series`} />
                  <div class="text-gray-700 font-content text-sm">
                    <ol class="list-decimal list-outside gap-2">
                      {seriesData.mappedSeriesEntries.map((seriesEntry) => (
                        <li class="ml-8 my-1">
                          {seriesEntry.slug === slug ? (
                            <span class="series-current" aria-current="page">
                              <i>{seriesEntry.title}</i> ({seriesEntry.year})
                            </span>
                          ) : seriesEntryIsShowcased(seriesEntry) ? (
                            <FilmShowcaseLink slug={seriesEntry.slug}>
                              <i>{seriesEntry.title}</i> ({seriesEntry.year})
                            </FilmShowcaseLink>
                          ) : (
                            <span class="text-gray-500">
                              <i>{seriesEntry.title}</i> ({seriesEntry.year})
                            </span>
                          )}
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button>close</button>
                </form>
              </dialog>
          </span>
          {
            precedingSeriesEntry && (
              <>
                <br />
                <span class="fact-note fact-plain">Preceded by </span>
                {seriesEntryIsShowcased(precedingSeriesEntry) ? (
                  <FilmShowcaseLink slug={precedingSeriesEntry.slug}>
                    <span class="italic">{precedingSeriesEntry.title}</span> (
                    {precedingSeriesEntry.year})
                  </FilmShowcaseLink>
                ) : (
                  <>
                    <span class="italic">{precedingSeriesEntry.title}</span> (
                    {precedingSeriesEntry.year})
                  </>
                )}
              </>
            )
          }
          {
            nextSeriesEntry && (
              <>
                <br />
                <span class="fact-note fact-plain">Followed by </span>
                {seriesEntryIsShowcased(nextSeriesEntry) ? (
                  <FilmShowcaseLink slug={nextSeriesEntry.slug}>
                    <span class="italic">{nextSeriesEntry.title}</span> (
                    {nextSeriesEntry.year})
                  </FilmShowcaseLink>
                ) : (
                  <>
                    <span class="italic">{nextSeriesEntry.title}</span> (
                    {nextSeriesEntry.year})
                  </>
                )}
              </>
            )
          }
      </Fact>
    )
  }
  {studios && studios.length > 0 && <Fact label="Studio">{studios.join(", ")}</Fact>}
</FactList>
  </div>
  <div class="film-rest">
<NamedDivider name="Staff" />
<div class="staff-grid">
  {
    displayStaff?.map((staffGroup) => (
      <div class="staff-item">
        <div class="">
          <span class="staff-role">{staffGroup.role}</span>
        </div>
        <div class="">
          {staffGroup.people.map((person) => (
            <div class="staff-name">
              <PersonShowcaseLink slug={person.slug}>
                {person.disambig_chars ? (
                  <>
                    {person.name}
                    <span class="text-xs">
                      (<span lang="ja" class="font-japanese">{person.disambig_chars}</span>)
                    </span>
                  </>
                ) : (
                  <>{person.name}</>
                )}
              </PersonShowcaseLink>
              <br />
              {person.alias && (
                <span class="text-gray-500 text-xs">as {person.alias}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
{
  creditRows && (
    <>
      <div class="credits-row">
        <button type="button" class="series-open" onclick="credits_modal.showModal()">
          Credits
        </button>
      </div>
      <dialog id="credits_modal" class="modal">
        <div class="modal-box max-h-[85vh]">
          <form method="dialog" class="modal-close">
            <button aria-label="Close" class="btn btn-sm btn-circle btn-ghost text-gray-700">
              <Icon name="x" set="tabler" variant="outline" class="h-5 w-5" />
            </button>
          </form>
          <NamedDivider name="Credits" />
          <div class="credit-cards">
            {creditCards.map((card) => (
              <div class="credit-card">
                {card.map((line) => (
                  <div class:list={["credit-line", { "credit-continued": line.continued }]}>
                    <div class="credit-role">
                      {!line.continued && (
                        <>
                          <span lang="ja" class="credit-ja">{line.japanese_role}</span>
                          <span>{line.role}</span>
                        </>
                      )}
                    </div>
                    <div class="credit-name">
                      <span lang="ja" class="credit-ja">{line.japanese_name}</span>
                      <PersonShowcaseLink slug={line.name ? personSlugFor(line.name) : undefined}>
                        {line.name}
                      </PersonShowcaseLink>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    </>
  )
}
  </div>
</div>
<CastBlockFromCsv rows={castCsv} />
{
  kaiju.length > 0 && (
    <>
      <NamedDivider name="Kaiju" />
      <CastCatalog>
        <section class="cast-group">
          <div class="cast-grid">
            {kaiju.map((monster) => (
              <RoleRow
                avatar_url={monster.avatar_url}
                avatar_alt={monster.name}
                role={monster.name}
                people={kaijuRolePeople(monster.portrayals)}
              />
            ))}
          </div>
        </section>
      </CastCatalog>
    </>
  )
}
<HomeVideoBlock filmSlug={slug} releases={homeVideos[slug] ?? []} />

<style>
  .film-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    width: 100%;
    align-items: start;
  }
  .film-poster {
    display: flex;
    justify-content: center;
  }
  .film-poster img {
    width: 270px;
    height: auto;
  }
  .film-side,
  .film-rest {
    min-width: 0;
  }
  .film-rest > :global(.named-divider:first-child) {
    margin-top: 0;
  }
  .read-link {
    margin-top: 4px;
    font-family: var(--font-content);
    font-size: 0.95rem;
    color: var(--color-red-700);
  }
  .series-open {
    display: block;
    width: fit-content;
    margin-top: 2px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-content);
    font-size: 0.95rem;
    color: var(--color-red-700);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .series-open.series-name {
    display: inline;
    width: auto;
    margin-top: 0;
  }
  .credits-row {
    margin-top: 18px;
  }
  .modal-close {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    height: 0;
    transform: translate(12px, -12px);
  }
  .modal-close button {
    background: white;
  }
  .series-current {
    font-weight: 600;
    color: var(--color-gray-700);
  }
  .credit-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-content);
    font-size: 0.875rem;
    color: var(--color-gray-700);
  }
  .credit-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .credit-card + .credit-card {
    border-top: 1px solid var(--color-gray-200);
    padding-top: 16px;
  }
  .credit-line {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .credit-continued {
    margin-top: -4px;
  }
  .credit-role,
  .credit-name {
    display: flex;
    flex-direction: column;
  }
  .credit-ja {
    font-family: var(--font-japanese);
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }
  .staff-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 28px;
    text-align: left;
  }
  .staff-role {
    font-family: var(--font-detail);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .staff-name {
    margin-top: 2px;
    font-family: var(--font-content);
    font-size: 0.95rem;
    color: var(--color-gray-700);
  }
  @media (min-width: 720px) {
    .film-hero {
      grid-template-columns: 270px fit-content(34rem);
      justify-content: center;
      column-gap: 40px;
      row-gap: 2rem;
    }
    .film-poster {
      grid-column: 1;
      grid-row: 1;
      justify-content: flex-start;
    }
    .film-side {
      grid-column: 2;
      grid-row: 1;
    }
    .film-rest {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .staff-grid {
      grid-template-columns: repeat(2, max-content);
      width: fit-content;
      margin-inline: auto;
      column-gap: 4rem;
    }
    .credits-row {
      display: flex;
      justify-content: center;
    }
  }
  @media (max-width: 520px) {
    .staff-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
