---
import Fact from "./Fact.astro";
import FactList from "./FactList.astro";
import NamedDivider from "./NamedDivider.astro";
import SelectedWorks from "./SelectedWorks.astro";
import { displayPersonDate, lifespan } from "../lib/dates";

interface Props {
  data: Record<string, unknown>;
  Content: Astro.Component;
}

const { data, Content } = Astro.props;

const name = data.name as string;
const avatar_url = data.avatar_url as string;
const japanese_name = data.japanese_name as string | undefined;
const active_period_start = data.active_period_start as string | number | undefined;
const active_period_end = data.active_period_end as string | number | undefined;
const members = data.members as
  | {
      name: string;
      dob?: string;
      dob_resolution?: string;
      dod?: string;
      dod_resolution?: string;
      birth_name?: string;
      japanese_birth_name?: string;
      birth_place?: string;
      death_place?: string;
      cause_of_death?: string;
    }[]
  | undefined;
const works = data.works as Record<string, unknown>[] | undefined;
---

<div class="text-center w-fit m-auto">
  <h1 class="font-display tracking-wider uppercase text-2xl text-gray-700 p-4">
    {name}
  </h1>
</div>
<div class="person-hero">
  <img
    class="rounded-lg drop-shadow-lg"
    src={avatar_url}
    alt={`Portrait of ${name}`}
    height="200"
    width="200"
  />
  <FactList>
    {japanese_name && (
      <Fact label="Japanese name">
        <span lang="ja" class="font-japanese">{japanese_name}</span>
      </Fact>
    )}
    {active_period_start && (
      <Fact label="Active">
        {active_period_start}–{active_period_end ?? "present"}
      </Fact>
    )}
  </FactList>
</div>
{
  members && members.length > 0 && (
    <>
      <NamedDivider name="Members" />
      <div class="group-members">
        {members.map((member) => (
          <div class="group-member">
            <h2 class="group-member-name">{member.name}</h2>
            <FactList>
              {member.dob && (
                <Fact label="Born">
                  {displayPersonDate(member.dob, member.dob_resolution)}
                  {!member.dod && <> ({lifespan(member.dob, new Date().toISOString())})</>}
                  {member.birth_name && (
                    <div class="fact-note fact-plain">{member.birth_name}</div>
                  )}
                  {member.japanese_birth_name && (
                    <div lang="ja" class="fact-note fact-plain font-japanese">
                      {member.japanese_birth_name}
                    </div>
                  )}
                  {member.birth_place && (
                    <div class="fact-note fact-plain">{member.birth_place}</div>
                  )}
                </Fact>
              )}
              {member.dod && typeof member.dod !== "string" && member.dob && (
                <Fact label="Died">
                  {displayPersonDate(member.dod, member.dod_resolution)} (
                  {lifespan(member.dob, member.dod)})
                  {member.death_place && (
                    <div class="fact-note fact-plain">{member.death_place}</div>
                  )}
                  {member.cause_of_death && (
                    <div class="fact-note fact-plain">{member.cause_of_death}</div>
                  )}
                </Fact>
              )}
            </FactList>
          </div>
        ))}
      </div>
    </>
  )
}
<NamedDivider name="Bio" />
<div class="reading pb-1 pt-2">
  <Content />
</div>
<NamedDivider name="Selected Works" />
<SelectedWorks works={works as never} />

<style>
  .group-members {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px 80px;
    padding: 8px 0 24px;
  }
  .group-member {
    width: fit-content;
    max-width: 100%;
  }
  .group-member :global(.facts .fact) {
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: 12px;
  }
  .group-member :global(.facts .fact + .fact) {
    margin-top: 8px;
  }
  .group-member-name {
    margin: 0 0 6px;
    font-family: var(--font-content);
    font-size: 1.05rem;
    color: var(--color-gray-700);
  }
</style>
