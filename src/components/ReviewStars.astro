---
import Icon from "./Icon.astro";

const RATING_LABELS: Record<number, string> = {
  1: "Bad",
  2: "Okay",
  3: "Good",
  4: "Great",
};

interface Props {
  star_rating?: number | string;
  show_label?: boolean;
  align?: "center" | "start";
}

const { star_rating, show_label = false, align = "center" } = Astro.props;
const n = Math.min(4, Math.max(0, Number(star_rating) || 0));
const alignStart = align === "start";
---

<div class:list={[alignStart ? "rating-start" : "text-center w-fit m-auto"]}>
  <div class:list={["flex gap-0.5", alignStart ? "justify-start" : "justify-center pt-1"]}>
    {
      Array.from({ length: 4 }, (_, i) => (
        <Icon
          name="star"
          set="tabler"
          variant={i < n ? "filled" : "outline"}
          class="inline h-6 w-6 text-amber-500"
        />
      ))
    }
  </div>
  {
    show_label && n > 0 && (
      <p class="rating-caption">
        {RATING_LABELS[n]} · {n} of 4
      </p>
    )
  }
</div>

<style>
  .rating-caption {
    margin: 8px 0 0;
    font-family: var(--font-content);
    font-size: 0.95rem;
    color: var(--color-gray-700);
  }
  .rating-start .rating-caption {
    margin-top: 2px;
    font-size: 0.8rem;
    color: var(--color-gray-500);
  }
</style>
