---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FilmPage from "../../components/FilmPage.astro";
import { filmRecordFromCsv, getFilmData, withFilmCsvFallbacks } from "../../lib/films";
import { getReviewSlugs } from "../../lib/reviews";

export async function getStaticPaths() {
  const films = await getCollection("films", ({ data }) => !data.draft);
  const reviewSlugs = await getReviewSlugs();
  const {
    films: filmRows,
    series,
    credits,
    staffs,
    casts,
    kaiju,
    originalWorks,
    originalWorkAuthors,
    homeVideos,
  } = getFilmData();

  return films.map((film) => {
    const slug = film.id.replace(/\.md$/, "");
    const filmRecord = filmRecordFromCsv(slug, filmRows);
    return {
      params: { slug },
      props: {
        data: withFilmCsvFallbacks(slug, film.data, filmRecord),
        hasWrittenReview: reviewSlugs.has(slug),
        filmRecord,
        seriesByName: series,
        films: filmRows,
        staffs,
        casts,
        kaiju,
        originalWorks,
        originalWorkAuthors,
        credits,
        homeVideos,
      },
    };
  });
}

interface Props {
  data: Record<string, unknown>;
  hasWrittenReview: boolean;
  filmRecord: ReturnType<typeof filmRecordFromCsv>;
  seriesByName: Record<string, { slug: string }[]>;
  films: ReturnType<typeof getFilmData>["films"];
  staffs: ReturnType<typeof getFilmData>["staffs"];
  casts: ReturnType<typeof getFilmData>["casts"];
  kaiju: ReturnType<typeof getFilmData>["kaiju"];
  originalWorks: ReturnType<typeof getFilmData>["originalWorks"];
  originalWorkAuthors: ReturnType<typeof getFilmData>["originalWorkAuthors"];
  credits: ReturnType<typeof getFilmData>["credits"];
  homeVideos: ReturnType<typeof getFilmData>["homeVideos"];
}

const { slug } = Astro.params;
const {
  data,
  hasWrittenReview,
  filmRecord,
  seriesByName,
  films,
  staffs,
  casts,
  kaiju,
  originalWorks,
  originalWorkAuthors,
  credits,
  homeVideos,
} = Astro.props;
---

<Layout title={data.title as string}>
  <FilmPage
    slug={slug!}
    data={data}
    hasWrittenReview={hasWrittenReview}
    filmRecord={filmRecord}
    seriesByName={seriesByName}
    films={films}
    staffs={staffs}
    casts={casts}
    kaiju={kaiju}
    originalWorks={originalWorks}
    originalWorkAuthors={originalWorkAuthors}
    credits={credits}
    homeVideos={homeVideos}
  />
</Layout>
