---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CatalogSearch from "../../components/CatalogSearch.astro";
import { formatDate } from "../../lib/dates";
import { getFilmData } from "../../lib/films";
import { getReviewSlugs } from "../../lib/reviews";

const films = (await getCollection("films", ({ data }) => !data.draft)).sort(
  (a, b) => a.id.localeCompare(b.id),
);
const reviewSlugs = await getReviewSlugs();
const seriesBySlug = new Map(
  getFilmData().films.map((row) => [row.slug, row.series_name]),
);

const catalog = films.map((film) => {
  const slug = film.id.replace(/\.md$/, "");
  const aliases = (film.data.aliases as { alias: string }[] | undefined) ?? [];
  const aliasNames = aliases.map((a) => a.alias);
  const year = formatDate(film.data.release_date as string, "yyyy");
  const decade = year ? String(Math.floor(Number(year) / 10) * 10) : "";
  const japanese = (film.data.japanese_title as string | undefined) ?? "";
  return {
    slug,
    title: film.data.title as string,
    poster: film.data.poster_url as string,
    year,
    decade,
    series: seriesBySlug.get(slug) ?? "",
    japanese,
    aliasNames,
    hasReview: reviewSlugs.has(slug) || Boolean(film.data.video_review),
  };
});

const decades = [...new Set(catalog.map((film) => film.decade).filter(Boolean))].sort();
const seriesNames = [...new Set(catalog.map((film) => film.series).filter(Boolean))].sort(
  (a, b) => a.localeCompare(b),
);
---

<Layout title="Films">
  <div class="text-center w-fit m-auto">
    <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
      Films
    </h1>
  </div>
  <div class="film-toolbar">
    <CatalogSearch
      label="Titles, aliases, years"
      total={films.length}
      noun="films"
      empty={false}
    />
    <div class="film-filters" id="film-filters">
      <button
        type="button"
        class="chip filters-toggle"
        id="filters-toggle"
        aria-expanded="false"
        aria-controls="filter-panel"
      >
        Filters<span id="filter-count"></span>
      </button>
      <div class="filter-panel" id="filter-panel">
        <div>
          <p class="filter-label" id="decade-label">Decade</p>
          <div class="chip-row" role="radiogroup" aria-labelledby="decade-label">
            <button type="button" class="chip" role="radio" data-decade="" aria-checked="true" tabindex="0">
              All
            </button>
            {
              decades.map((decade) => (
                <button type="button" class="chip" role="radio" data-decade={decade} aria-checked="false" tabindex="-1">
                  {decade}s
                </button>
              ))
            }
          </div>
        </div>
        <div class="filter-tools">
          <label class="series-filter">
            <span class="filter-label">Series</span>
            <select id="series-filter" class="select">
              <option value="">All</option>
              {seriesNames.map((name) => <option value={name}>{name}</option>)}
            </select>
          </label>
          <button type="button" class="chip" id="review-filter" aria-pressed="false">
            Has review
          </button>
        </div>
      </div>
    </div>
  <p
    id="search-empty"
    class="search-empty"
    hidden
    aria-live="polite"
    data-alt-href="/people"
    data-alt-noun="people"
  ></p>
  </div>
  <div class="film-catalog">
    <div id="search-results" class="film-grid">
      {
        catalog.map((film) => (
          <div
            class="filterable film-result"
            data-terms={`${film.title} ${film.year} ${film.japanese} ${film.aliasNames.join(" ")}`}
            data-primary={film.title}
            data-year={film.year}
            data-decade={film.decade}
            data-series={film.series}
            data-review={film.hasReview ? "true" : "false"}
            data-japanese={film.japanese}
            data-alternates={JSON.stringify(film.aliasNames)}
          >
            <a class="film-card" href={`/films/${film.slug}`}>
              <img
                class="film-still"
                alt=""
                height={113}
                width={80}
                src={film.poster}
                loading="lazy"
              />
              <span class="film-copy">
                <span class="film-title">{film.title}</span>
                {film.year && <span class="film-year">{film.year}</span>}
                <span class="match-note" hidden></span>
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
  <script is:inline src="/scripts/filter.js"></script>
</Layout>

<style>
  .film-toolbar {
    width: 100%;
  }
  .film-filters {
    margin: 0 0 20px;
  }
  .filter-panel {
    display: none;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
  }
  .film-filters.is-open .filter-panel {
    display: flex;
  }
  .search-empty {
    margin: 28px auto;
    max-width: 28rem;
    text-align: center;
    font-family: var(--font-content);
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--color-gray-700);
  }
  @media (min-width: 721px) {
    .film-filters {
      margin: 8px 0 28px;
    }
    .filters-toggle {
      display: none;
    }
    .filter-panel {
      display: flex;
      margin-top: 0;
    }
    .search-empty {
      margin-top: 0;
    }
  }
  .filter-label {
    margin: 0 0 8px;
    font-family: var(--font-detail);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .chip-row,
  .filter-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 8px;
  }
  .chip {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid #d4d4d8;
    border-radius: var(--radius-selector);
    background: white;
    font-family: var(--font-detail);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-gray-700);
    cursor: pointer;
  }
  .chip[aria-pressed="true"],
  .chip[aria-checked="true"] {
    color: var(--color-red-700);
    border-color: var(--color-red-700);
    background-color: var(--color-red-100);
  }
  .chip:hover {
    color: var(--color-red-700);
  }
  .chip:focus-visible,
  .series-filter select:focus-visible,
  .film-card:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 3px;
  }
  .series-filter {
    display: flex;
    flex-direction: column;
  }
  .series-filter select {
    height: 44px;
    font-family: var(--font-detail);
    color: var(--color-gray-700);
  }
  .series-filter select.is-set {
    --input-color: var(--color-red-700);
    border-color: var(--color-red-700);
    color: var(--color-red-700);
  }
  .filter-tools .chip {
    align-self: flex-end;
  }
  .film-catalog {
    width: min(100%, 64rem);
    margin-inline: auto;
  }
  .film-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 24px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .film-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .film-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .film-still {
    width: 80px;
    height: 113px;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    background: var(--color-gray-100);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .film-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .film-title {
    font-family: var(--font-content);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-gray-700);
  }
  .film-card:hover .film-title,
  .film-card:focus-visible .film-title {
    color: var(--color-red-700);
    text-decoration: underline;
    text-decoration-color: var(--color-red-700);
    text-underline-offset: 3px;
  }
  .film-year {
    font-family: var(--font-detail);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
</style>
