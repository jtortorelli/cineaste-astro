---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { load } from "js-yaml";
import Layout from "../../layouts/Layout.astro";
import AboutTabs from "../../components/AboutTabs.astro";
import NamedDivider from "../../components/NamedDivider.astro";
import CineasteLink from "../../components/CineasteLink.astro";


type WebsiteEntry = {
  name: string;
  domain?: string;
  resource_url?: string;
  author?: string;
  alias?: string;
};

type BookEntry = {
  name: string;
  subtitle?: string;
  author?: string;
};

type LabelEntry = {
  name: string;
};

const data = load(
  readFileSync(join(process.cwd(), "src/data/acknowledgements.yaml"), "utf8"),
) as {
  influences: WebsiteEntry[];
  resources: WebsiteEntry[];
  books: BookEntry[];
  labels: LabelEntry[];
};

function linkUrl(entry: WebsiteEntry): string | undefined {
  if (entry.resource_url) return entry.resource_url;
  if (entry.domain) return `https://${entry.domain}`;
  return undefined;
}

const websiteSections = [
  { title: "Influences", entries: data.influences },
  { title: "Resources", entries: data.resources },
];
---

<Layout title="Acknowledgements">
  <div class="text-center w-fit m-auto">
    <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
      About
    </h1>
  </div>
  <AboutTabs />

  {
    websiteSections.map((section) => (
      <>
        <NamedDivider name={section.title} />
        <ul class="reading ack-list">
          {section.entries.map((entry) => {
            const href = linkUrl(entry);
            return (
              <li>
                {href ? <CineasteLink href={href}>{entry.name}</CineasteLink> : entry.name}
                {entry.alias && <div class="ack-note">aka {entry.alias}</div>}
                {entry.author && <div class="ack-note">{entry.author}</div>}
              </li>
            );
          })}
        </ul>
      </>
    ))
  }

  <NamedDivider name="Books" />
  <ul class="reading ack-list">
    {
      data.books.map((book) => (
        <li>
          <i>
            {book.name}
            {book.subtitle && <>: {book.subtitle}</>}
          </i>
          {book.author && <div class="ack-note">{book.author}</div>}
        </li>
      ))
    }
  </ul>

  <NamedDivider name="Labels" />
  <ul class="reading ack-labels">
    {data.labels.map((label) => <li>{label.name}</li>)}
  </ul>
</Layout>

<style>
  .ack-list {
    list-style: none;
    padding: 0;
  }
  .ack-list > li + li {
    margin-top: 14px;
  }
  .ack-note {
    font-size: 0.85rem;
    color: var(--color-gray-500);
  }
  .ack-labels {
    list-style: none;
    padding: 0;
    columns: 3 10rem;
    column-gap: 24px;
  }
  .ack-labels > li {
    margin: 0;
    padding: 3px 0;
    break-inside: avoid;
  }
</style>
