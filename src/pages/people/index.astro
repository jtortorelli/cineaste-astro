---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CatalogSearch from "../../components/CatalogSearch.astro";
import PersonDateRange from "../../components/PersonDateRange.astro";

const people = (await getCollection("people")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

<Layout title="People">
  <div class="text-center w-fit m-auto">
    <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
      People
    </h1>
  </div>
  <div class="pb-6">
    <CatalogSearch
      label="Names and aliases"
      total={people.length}
      noun="people"
      altHref="/films"
      altNoun="films"
    />
  </div>
  <div>
    <div
      id="search-results"
      class="flex flex-col sm:flex-row sm:flex-wrap justify-center items-start gap-4"
    >
      {
        people.map((p) => {
          const slug = p.id.replace(/\.md$/, "");
          const aliases = (p.data.aliases as { name: string }[] | undefined) ?? [];
          const members =
            (p.data.members as { name: string; birth_name?: string }[] | undefined) ??
            [];
          const japanese = (p.data.japanese_name as string | undefined) ?? "";
          const birthName = (p.data.birth_name as string | undefined) ?? "";
          const alternates = [
            ...aliases.map((a) => a.name),
            birthName,
            japanese,
            ...members.flatMap((m) => [m.name, m.birth_name ?? ""]),
          ].filter((value) => value.length > 0);
          return (
            <div
              class="filterable sm:w-32"
              data-terms={`${p.data.name} ${birthName} ${japanese} ${alternates.join(" ")}`}
              data-primary={p.data.name as string}
              data-japanese={japanese}
              data-alternates={JSON.stringify(alternates)}
            >
              <a
                class="person-card group grid grid-cols-[100px_auto] gap-3 sm:flex sm:flex-col sm:items-center sm:gap-0"
                href={`/people/${slug}`}
              >
                <img
                  class="h-[100px] w-[100px] rounded-lg drop-shadow-lg"
                  src={p.data.avatar_url as string}
                  alt=""
                />
                <span class="block sm:text-center pt-3">
                  <span class="block font-content text-sm underline decoration-red-700 decoration-1 underline-offset-2 group-hover:text-red-700">
                    {p.data.name as string}
                  </span>
                  {p.data.profession && (
                    <span class="block font-content text-xs text-gray-500">
                      {p.data.profession as string}
                    </span>
                  )}
                  {p.data.type == "person" && (
                    <span class="block font-content text-xs text-gray-500">
                      <PersonDateRange p={p.data as never} />
                    </span>
                  )}
                  <span class="match-note block" hidden></span>
                </span>
              </a>
            </div>
          );
        })
      }
      <div></div>
    </div>
  </div>
  <script is:inline src="/scripts/filter.js"></script>
</Layout>

<style>
  .person-card {
    color: inherit;
    text-decoration: none;
  }
  .person-card:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 4px;
  }
  .person-card :global(.match-note[hidden]) {
    display: none;
  }
</style>
