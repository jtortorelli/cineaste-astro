---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CatalogSearch from "../../components/CatalogSearch.astro";

const people = (await getCollection("people")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
---

<Layout title="People">
  <div class="text-center w-fit m-auto">
    <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
      People
    </h1>
  </div>
  <div class="pb-6">
    <CatalogSearch
      label="Names and aliases"
      total={people.length}
      noun="people"
      altHref="/films"
      altNoun="films"
    />
  </div>
  <div class="person-catalog">
    <div id="search-results" class="person-grid">
      {
        people.map((p) => {
          const slug = p.id.replace(/\.md$/, "");
          const aliases = (p.data.aliases as { name: string }[] | undefined) ?? [];
          const members =
            (p.data.members as { name: string; birth_name?: string }[] | undefined) ??
            [];
          const japanese = (p.data.japanese_name as string | undefined) ?? "";
          const birthName = (p.data.birth_name as string | undefined) ?? "";
          const alternates = [
            ...aliases.map((a) => a.name),
            birthName,
            japanese,
            ...members.flatMap((m) => [m.name, m.birth_name ?? ""]),
          ].filter((value) => value.length > 0);
          return (
            <div
              class="filterable person-result"
              data-terms={`${p.data.name} ${birthName} ${japanese} ${alternates.join(" ")}`}
              data-primary={p.data.name as string}
              data-japanese={japanese}
              data-alternates={JSON.stringify(alternates)}
            >
              <a class="person-card" href={`/people/${slug}`}>
                <img
                  class="person-still"
                  alt=""
                  height={80}
                  width={80}
                  src={p.data.avatar_url as string}
                  loading="lazy"
                />
                <span class="person-copy">
                  <span class="person-name">{p.data.name as string}</span>
                  {p.data.profession && (
                    <span class="person-profession">{p.data.profession as string}</span>
                  )}
                  <span class="match-note" hidden></span>
                </span>
              </a>
            </div>
          );
        })
      }
    </div>
  </div>
  <script is:inline src="/scripts/filter.js"></script>
</Layout>

<style>
  .person-catalog {
    width: min(100%, 64rem);
    margin-inline: auto;
  }
  .person-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 24px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .person-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .person-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .person-still {
    width: 80px;
    height: 80px;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    background: var(--color-gray-100);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .person-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .person-name {
    font-family: var(--font-content);
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-gray-700);
  }
  .person-card:hover .person-name,
  .person-card:focus-visible .person-name {
    color: var(--color-red-700);
    text-decoration: underline;
    text-decoration-color: var(--color-red-700);
    text-underline-offset: 3px;
  }
  .person-profession {
    font-family: var(--font-detail);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-500);
  }
  .person-card:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 3px;
  }
  .person-card :global(.match-note[hidden]) {
    display: none;
  }
</style>
