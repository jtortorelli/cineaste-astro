---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CineasteLink from "../../components/CineasteLink.astro";
import CatalogSearch from "../../components/CatalogSearch.astro";
import PersonDateRange from "../../components/PersonDateRange.astro";

function sortKeyForName(name: string): string {
  return name.replace(/^The /, "");
}

const people = (await getCollection("people")).sort((a, b) =>
  sortKeyForName(a.data.name as string).localeCompare(
    sortKeyForName(b.data.name as string),
  ),
);
---

<Layout title="People">
  <div class="text-center w-fit m-auto">
    <h1 class="font-display tracking-wider uppercase p-4 text-2xl text-gray-700">
      People
    </h1>
  </div>
  <div class="pb-6">
    <CatalogSearch
      label="Names and aliases"
      total={people.length}
      noun="people"
    />
  </div>
  <div>
    <div
      id="search-results"
      class="flex flex-col sm:flex-row sm:flex-wrap justify-center items-start gap-4"
    >
      {
        people.map((p) => {
          const slug = p.id.replace(/\.md$/, "");
          const aliases = (p.data.aliases as { name: string }[] | undefined) ?? [];
          const members =
            (p.data.members as { name: string; birth_name?: string }[] | undefined) ??
            [];
          const japanese = (p.data.japanese_name as string | undefined) ?? "";
          const birthName = (p.data.birth_name as string | undefined) ?? "";
          const alternates = [
            ...aliases.map((a) => a.name),
            birthName,
            japanese,
            ...members.flatMap((m) => [m.name, m.birth_name ?? ""]),
          ].filter((value) => value.length > 0);
          return (
            <div
              class="filterable sm:flex sm:flex-col sm:w-32 grid grid-cols-[100px_auto]"
              data-terms={`${p.data.name} ${birthName} ${japanese} ${alternates.join(" ")}`}
              data-primary={p.data.name as string}
              data-japanese={japanese}
              data-alternates={JSON.stringify(alternates)}
            >
              <div>
                <a href={`/people/${slug}`}>
                  <div class="text-center w-fit m-auto">
                    <img
                      class="h-[100px] w-[100px] max-w-[150px] rounded-lg drop-shadow-lg"
                      src={p.data.avatar_url as string}
                    />
                  </div>
                </a>
              </div>
              <div class="sm:text-center pt-3">
                <a href={`/people/${slug}`}>
                  <CineasteLink href={`/people/${slug}`}>
                    <div class="font-content text-sm">{p.data.name as string}</div>
                  </CineasteLink>
                  {p.data.profession && (
                    <div class="font-content text-xs text-gray-500">
                      {p.data.profession as string}
                    </div>
                  )}
                  {p.data.type == "person" && (
                    <div class="font-content text-xs text-gray-500">
                      <PersonDateRange p={p.data as never} />
                    </div>
                  )}
                </a>
                <p class="match-note" hidden></p>
              </div>
            </div>
          );
        })
      }
      <div></div>
    </div>
  </div>
  <script is:inline src="/scripts/filter.js"></script>
</Layout>
