---
import Icon from "../components/Icon.astro";
import SocialLink from "../components/SocialLink.astro";

interface Props {
  title?: string;
  name?: string;
}

const { title, name } = Astro.props;
const pageTitle = title
  ? `${title} - The Godzilla Cineaste`
  : name
    ? `${name} - The Godzilla Cineaste`
    : "The Godzilla Cineaste";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}

const nav = [
  { href: "/about", label: "About" },
  { href: "/films", label: "Films" },
  { href: "/people", label: "People" },
];

const showHeaderSearch = !["/", "/films", "/people"].includes(pathname);
const headerSearch = pathname.startsWith("/people")
  ? { action: "/people", label: "Names and aliases" }
  : { action: "/films", label: "Titles, aliases, years" };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="site-shell flex flex-col">
      <div>
        <header class="site-header px-4 sm:px-6 lg:px-8">
          <div class="site-header-bar">
            <a
              href="/"
              class="wordmark"
              aria-current={pathname === "/" ? "page" : undefined}
            >
              The Godzilla Cineaste
              <small>godzillacineaste.net</small>
            </a>
            <button
              type="button"
              class="nav-toggle"
              aria-expanded="false"
              aria-controls="site-nav"
              aria-label="Menu"
            >
              <svg
                class="icon-open"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 6h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 18h16"></path>
              </svg>
              <span class="icon-close" aria-hidden="true">
                <Icon name="x" set="tabler" variant="outline" class="h-5 w-5" />
              </span>
            </button>
            {
              showHeaderSearch && (
                <form class="header-search" action={headerSearch.action} method="get" role="search">
                  <span class="header-search-icon" aria-hidden="true">
                    <Icon name="search" set="tabler" variant="outline" class="h-4 w-4" />
                  </span>
                  <input
                    type="search"
                    name="q"
                    placeholder={headerSearch.label}
                    aria-label={headerSearch.label}
                    autocomplete="off"
                  />
                </form>
              )
            }
            <nav id="site-nav" class="site-nav" aria-label="Primary">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </header>
        <main class="px-4 py-10 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <slot />
          </div>
        </main>
      </div>
      <footer class="px-4 sm:px-6 lg:px-8 py-9">
        <div
          class="w-fit m-auto font-content text-sm text-center tracking-wider text-gray-500"
        >
          <p>Est. 2016</p>
          <p>James Tortorelli</p>
          <p class="font-detail text-xs pb-2">@jingowestern</p>

          <nav class="social-row" aria-label="Elsewhere">
            <SocialLink
              href="https://x.com/jingowestern"
              name="x"
              label="X (formerly Twitter)"
            />
            <SocialLink
              href="https://www.youtube.com/@jingowestern"
              name="youtube"
              label="YouTube"
            />
            <SocialLink
              href="https://rumble.com/c/c-7743057"
              name="rumble"
              label="Rumble"
            />
            <SocialLink
              href="https://odysee.com/@jingowestern:3"
              name="odysee"
              label="Odysee"
            />
          </nav>
        </div>
      </footer>
    </div>
    <style>
      .site-shell {
        min-height: 100vh;
      }
      .social-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 8px;
        margin-top: 4px;
      }
      .site-header-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px 16px;
        padding: 12px 0;
      }
      .wordmark {
        margin-right: auto;
        flex: none;
        font-family: var(--font-content);
        color: var(--color-red-700);
        font-size: 1.25rem;
        line-height: 1.15;
        text-decoration: none;
      }
      .wordmark small {
        display: block;
        margin-top: 2px;
        font-family: var(--font-detail);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-gray-500);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .site-nav a {
        font-family: var(--font-content);
        font-size: 1rem;
        color: var(--color-gray-700);
        padding: 10px 12px;
        border-bottom: 2px solid transparent;
        text-decoration: none;
      }
      .site-nav a[aria-current="page"] {
        color: var(--color-red-700);
        border-bottom-color: var(--color-red-700);
      }
      .site-nav a:hover {
        color: var(--color-red-700);
      }
      .site-nav a:focus-visible,
      .wordmark:focus-visible,
      .nav-toggle:focus-visible {
        outline: 2px solid var(--color-red-700);
        outline-offset: 3px;
      }
      .nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--color-gray-700);
        cursor: pointer;
      }
      .nav-toggle .icon-close {
        display: none;
      }
      .nav-toggle[aria-expanded="true"] .icon-open {
        display: none;
      }
      .nav-toggle[aria-expanded="true"] .icon-close {
        display: flex;
      }
      .nav-toggle .icon-close :global(svg) {
        width: 24px;
        height: 24px;
      }
      .header-search {
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 0 1 13.5rem;
        width: 13.5rem;
        min-width: 0;
        height: 36px;
        border: 1px solid #d4d4d8;
        border-radius: 999px;
        padding: 0 12px 0 10px;
        color: var(--color-red-700);
        background: white;
      }
      .header-search:focus-within {
        outline: 2px solid var(--color-red-700);
        outline-offset: 2px;
      }
      .header-search-icon {
        display: flex;
        flex: none;
      }
      .header-search-icon :global(svg) {
        width: 16px;
        height: 16px;
      }
      .header-search input {
        border: 0;
        width: 100%;
        min-width: 0;
        padding: 0;
        font-family: var(--font-content);
        font-size: 0.9rem;
        color: var(--color-gray-700);
        background: transparent;
      }
      .header-search input:focus {
        outline: none;
      }
      .header-search input::-webkit-search-cancel-button {
        -webkit-appearance: none;
        appearance: none;
      }
      @media (min-width: 721px) {
        .site-header-bar {
          flex-wrap: nowrap;
        }
      }
      @media (max-width: 720px) {
        .nav-toggle {
          display: flex;
        }
        .header-search {
          flex: 1 1 100%;
          width: auto;
          max-width: none;
          order: 3;
        }
        .site-nav {
          display: none;
          flex: 1 1 100%;
          flex-direction: column;
          align-items: stretch;
          order: 4;
          gap: 0;
          padding-bottom: 4px;
        }
        .site-nav.is-open {
          display: flex;
          margin: 0 -1rem;
          padding: 4px 1rem 12px;
          background: white;
        }
        .site-header:has(.site-nav.is-open) {
          position: relative;
          z-index: 2;
          background: white;
          box-shadow: 0 14px 22px -14px rgba(24, 24, 27, 0.55);
        }
        .site-nav a {
          padding: 12px 4px;
          border-bottom-color: transparent;
        }
        .site-nav a[aria-current="page"] {
          border-bottom-color: transparent;
        }
      }
    </style>
    <script is:inline>
      const navToggle = document.querySelector(".nav-toggle");
      const siteNav = document.getElementById("site-nav");
      if (navToggle && siteNav) {
        navToggle.addEventListener("click", () => {
          const open = navToggle.getAttribute("aria-expanded") === "true";
          navToggle.setAttribute("aria-expanded", open ? "false" : "true");
          navToggle.setAttribute("aria-label", open ? "Menu" : "Close menu");
          siteNav.classList.toggle("is-open", !open);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          if (navToggle.getAttribute("aria-expanded") !== "true") return;
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Menu");
          siteNav.classList.remove("is-open");
          navToggle.focus();
        });
      }
    </script>
  </body>
</html>
