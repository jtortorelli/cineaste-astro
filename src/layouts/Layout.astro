---
import SocialLink from "../components/SocialLink.astro";

interface Props {
  title?: string;
  name?: string;
}

const { title, name } = Astro.props;
const pageTitle = title
  ? `${title} - The Godzilla Cineaste`
  : name
    ? `${name} - The Godzilla Cineaste`
    : "The Godzilla Cineaste";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}

const nav = [
  { href: "/about", label: "About" },
  { href: "/films", label: "Films" },
  { href: "/people", label: "People" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="site-shell flex flex-col">
      <div>
        <header class="site-header px-4 sm:px-6 lg:px-8">
          <div class="site-header-bar">
            <a
              href="/"
              class="wordmark"
              aria-current={pathname === "/" ? "page" : undefined}
            >
              The Godzilla Cineaste
              <small>godzillacineaste.net</small>
            </a>
            <nav class="site-nav" aria-label="Primary">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </header>
        <main class="px-4 py-10 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <slot />
          </div>
        </main>
      </div>
      <footer class="px-4 sm:px-6 lg:px-8 py-9">
        <div
          class="w-fit m-auto font-content text-sm text-center tracking-wider text-gray-500"
        >
          <p>Est. 2016</p>
          <p>James Tortorelli</p>
          <p class="font-detail text-xs pb-2">@jingowestern</p>

          <nav class="social-row" aria-label="Elsewhere">
            <SocialLink
              href="https://x.com/jingowestern"
              name="x"
              label="X (formerly Twitter)"
            />
            <SocialLink
              href="https://www.youtube.com/@jingowestern"
              name="youtube"
              label="YouTube"
            />
            <SocialLink
              href="https://rumble.com/c/c-7743057"
              name="rumble"
              label="Rumble"
            />
            <SocialLink
              href="https://odysee.com/@jingowestern:3"
              name="odysee"
              label="Odysee"
            />
          </nav>
        </div>
      </footer>
    </div>
    <style>
      .site-shell {
        min-height: 100vh;
      }
      .social-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 8px;
        margin-top: 4px;
      }
      .site-header {
        border-bottom: 1px solid #e4e4e7;
      }
      .site-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 12px 0;
      }
      .wordmark {
        font-family: var(--font-content);
        color: var(--color-red-700);
        font-size: 1.25rem;
        line-height: 1.15;
        text-decoration: none;
      }
      .wordmark small {
        display: block;
        margin-top: 2px;
        font-family: var(--font-detail);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-gray-500);
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .site-nav a {
        font-family: var(--font-content);
        font-size: 1rem;
        color: var(--color-gray-700);
        padding: 10px 12px;
        border-bottom: 2px solid transparent;
        text-decoration: none;
      }
      .site-nav a[aria-current="page"] {
        color: var(--color-red-700);
        border-bottom-color: var(--color-red-700);
      }
      .site-nav a:hover {
        color: var(--color-red-700);
      }
      .site-nav a:focus-visible,
      .wordmark:focus-visible {
        outline: 2px solid var(--color-red-700);
        outline-offset: 3px;
      }
    </style>
  </body>
</html>
